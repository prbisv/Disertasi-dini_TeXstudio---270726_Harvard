file = {:C$\backslash$:/Users/ASUS/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Chen et al. - 2020 - Deep Learning for Cardiac Image Segmentation A Review.pdf:pdf},
issn = {2297055X},
journal = {Frontiers in Cardiovascular Medicine},
keywords = {CT,MRI,artificial intelligence,cardiac image analysis,cardiac image segmentation,deep learning,neural networks,ultrasound},
month = {mar},
