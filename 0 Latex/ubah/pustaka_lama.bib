file = {:D$\backslash$:/Dropbox/riseto3/Left{\_}ventricle{\_}segmentation{\_}using{\_}fully{\_}convol.pdf:pdf;:C$\backslash$:/Users/ASUS/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Mattias - 2018 - Myocardial Segmentation in MR images using Convolutional Neural Networks.pdf:pdf},
